PORT=3000
CHATVERSE_DATA_DIR=./data
# Register this EXACT URL in your own confidential Twitch developer app.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
# Register this second redirect for the separate viewer companion sign-in.
TWITCH_VIEWER_REDIRECT_URI=http://localhost:3000/auth/viewer/callback
# Optional verified supporter-rank cosmetics (Knight / Baron / Duke).
# Reauthorize after enabling to grant channel:read:subscriptions. Gameplay does not require it.
TWITCH_SUBSCRIPTIONS=false
# Optional compatible text generation endpoint. Leave unset for deterministic narration.
STEWARD_ENDPOINT=
STEWARD_API_KEY=
STEWARD_MODEL=
